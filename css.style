/* ==========================================================================
   STYLE.CSS - PANDUAN GAYA PEMBELAJARAN INTERAKTIF GEN Z BRIGHT PALETTE
   Mata Kuliah: Bimbingan dan Konseling ABK / Ortopedagogik
   ========================================================================== */

/* --- 1. VARIABEL & RESET DASAR --- */
:root {
  --gz-purple: #7c3aed;
  --gz-purple-light: #f3e8ff;
  --gz-purple-hover: #6d28d9;
  --gz-orange: #f97316;
  --gz-orange-light: #ffedd5;
  --gz-blue: #0284c7;
  --gz-blue-light: #e0f2fe;
  --gz-bg-bright: #fafcfb;
  --gz-text-dark: #0f172a;
  --text-muted: #475569;
  --border-color: #e2e8f0;
  
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--gz-bg-bright);
  color: var(--gz-text-dark);
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: 1.75;
  font-size: 1.05rem;
  -webkit-font-smoothing: antialiased;
}

/* --- 2. SISTEM VISIBILITAS TAB (KUNCI AGAR HALAMAN TIDAK MENUMPUK) --- */
.view-section {
  display: none !important;
}

.view-section.active {
  display: block !important;
}

.slide-item {
  display: none !important;
}

.slide-item.active {
  display: block !important;
}

/* --- 3. STRUKTUR HEADER & NAVIGASI ATAS --- */
.site-header {
  background: #ffffff;
  border-bottom: 1.5px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: var(--shadow-sm);
}

.nav-container {
  max-width: 1040px;
  margin: 0 auto;
  padding: 1.1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.brand-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-weight: 800;
  font-size: 1.15rem;
  letter-spacing: -0.02em;
}

.view-tabs {
  display: flex;
  gap: 0.6rem;
}

.tab-btn {
  background: #f1f5f9;
  border: 1.5px solid #cbd5e1;
  padding: 0.7rem 1.35rem;
  border-radius: var(--radius-sm);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: inherit;
}

.tab-btn:hover {
  background: #e2e8f0;
  color: var(--gz-text-dark);
}

.tab-btn.active {
  background: var(--gz-purple) !important;
  color: #ffffff !important;
  border-color: var(--gz-purple) !important;
  box-shadow: 0 4px 10px rgba(124, 58, 237, 0.25);
}

/* --- 4. PEMBATAS KONTEN UTAMA --- */
.content-wrapper {
  max-width: 1040px;
  margin: 2.5rem auto;
  padding: 0 2rem;
}

/* --- 5. LENCANA (BADGES & PILLS) --- */
.pill {
  padding: 0.4rem 1rem;
  border-radius: 999px;
  font-size: 0.85rem;
  display: inline-block;
  line-height: 1.2;
}

.badge-purple {
  background: var(--gz-purple-light);
  color: var(--gz-purple);
  font-weight: 800;
}

.badge-orange {
  background: var(--gz-orange-light);
  color: #c2410c;
  font-weight: 800;
}

.badge-blue {
  background: var(--gz-blue-light);
  color: var(--gz-blue);
  font-weight: 800;
}

/* --- 6. KOTAK JUDUL (HERO BANNER) & KARTU KONTEN --- */
.hero-box {
  border-radius: var(--radius-lg);
  padding: 3.5rem 3.25rem;
  margin-bottom: 2.5rem;
  border: 1.5px solid var(--border-color);
  box-shadow: var(--shadow-md);
}

.hero-box h1 {
  font-size: clamp(2rem, 3.2vw, 2.5rem);
  line-height: 1.35;
  margin: 1.5rem 0 1rem 0;
  max-width: 900px;
  color: var(--gz-text-dark);
}

.hero-box p {
  font-size: 1.12rem;
  color: #334155;
  line-height: 1.8;
  max-width: 900px;
}

.hero-meta {
  display: flex;
  gap: 1.75rem;
  flex-wrap: wrap;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(226, 232, 240, 0.8);
  font-size: 0.95rem;
  color: var(--text-muted);
  font-weight: 600;
}

.content-card {
  background: #ffffff;
  border: 1.5px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 3rem 2.75rem;
  margin-bottom: 2.5rem;
  box-shadow: var(--shadow-sm);
}

.content-card h2 {
  font-size: 1.65rem;
  color: var(--gz-text-dark);
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  line-height: 1.4;
}

.quote-box {
  border-left: 5px solid var(--gz-blue);
  background: #f0f9ff;
  padding: 1.5rem 2rem;
  margin: 2rem 0;
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  font-size: 1.08rem;
  line-height: 1.8;
}

.grid-two-col {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.75rem;
  margin-top: 2rem;
}

.accent-card {
  padding: 2rem 1.75rem;
  border-radius: var(--radius-md);
}

.card-purple-bright {
  border-left: 5px solid var(--gz-purple);
  background: #faf5ff;
}

.card-orange-bright {
  border-left: 5px solid var(--gz-orange);
  background: #fff7ed;
}

.card-blue-bright {
  border-left: 5px solid var(--gz-blue);
  background: #f0f9ff;
}

/* --- 7. DIAGRAM & KUIS INTERAKTIF --- */
.diagram-container {
  margin: 2.25rem 0;
}

.diagram-caption {
  text-align: center;
  font-size: 0.92rem;
  color: #64748b;
  margin-top: 0.5rem;
  font-style: italic;
}

.game-card {
  border: 2px dashed #c4b5fd;
  background: #faf5ff;
  padding: 2rem;
  border-radius: var(--radius-md);
  margin-top: 1.25rem;
}

.sound-toggle-bar {
  margin-bottom: 1.25rem;
}

.sound-btn {
  background: #ffffff;
  border: 1.5px solid var(--gz-purple);
  color: var(--gz-purple);
  padding: 8px 18px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: 700;
  font-family: inherit;
  font-size: 0.95rem;
  transition: all 0.2s ease;
}

.sound-btn:hover {
  background: var(--gz-purple-light);
}

.quiz-option {
  width: 100%;
  text-align: left;
  padding: 1.15rem 1.4rem;
  margin-bottom: 0.85rem;
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: var(--radius-md);
  cursor: pointer;
  font-size: 1.02rem;
  line-height: 1.6;
  font-family: inherit;
  transition: all 0.2s ease;
}

.quiz-option:hover {
  border-color: var(--gz-purple);
  background: #fbf8ff;
}

.quiz-feedback {
  display: none;
  padding: 1.35rem 1.6rem;
  border-radius: var(--radius-md);
  margin-top: 1.35rem;
  font-size: 1.02rem;
  line-height: 1.7;
}

/* --- 8. LEMBAR KERJA MAHASISWA (WORKSHEET VIEW) --- */
.print-action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  background: #ffffff;
  padding: 1.75rem;
  border-radius: var(--radius-md);
  border: 1.5px solid var(--border-color);
  box-shadow: var(--shadow-sm);
}

.worksheet-paper {
  background: #ffffff;
  padding: 3rem;
  border-radius: var(--radius-lg);
  border: 2px solid var(--border-color);
  box-shadow: var(--shadow-md);
}

.large-answer-area {
  width: 100%;
  min-height: 240px;
  padding: 1.35rem;
  font-family: inherit;
  font-size: 1.05rem;
  line-height: 1.7;
  border: 2px solid #cbd5e1;
  border-radius: var(--radius-md);
  background: #ffffff;
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
  resize: vertical;
  margin-top: 1rem;
  margin-bottom: 1.5rem;
  box-sizing: border-box;
}

.large-answer-area:focus {
  border-color: var(--gz-purple);
  outline: none;
  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
}

/* --- 9. PRESENTASI SLIDE DOSEN --- */
.presentation-frame-bright {
  background: #ffffff;
  color: #1e293b;
  border: 2px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 3.5rem 3.25rem 2.5rem 3.25rem;
  min-height: 560px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: var(--shadow-lg);
}

.presentation-frame-bright h2 {
  color: var(--gz-text-dark);
  font-size: clamp(2rem, 3.8vw, 2.5rem);
  margin-bottom: 1.5rem;
  margin-top: 0.75rem;
}

.presentation-frame-bright .slide-body {
  font-size: 1.25rem;
  line-height: 1.85;
  color: #334155;
  flex-grow: 1;
}

.presentation-frame-bright .slide-body p {
  font-weight: 600;
  margin-bottom: 1rem;
}

.presentation-frame-bright .slide-body li {
  margin-bottom: 1rem;
  position: relative;
  padding-left: 2rem;
  list-style: none;
}

.presentation-frame-bright .slide-body li::before {
  content: "✦";
  position: absolute;
  left: 0;
  color: var(--gz-purple);
  font-weight: 800;
  font-size: 1.15rem;
}

.speaker-notes-bright {
  margin-top: 1.75rem;
  background: #f8fafc;
  border-left: 4px solid var(--gz-orange);
  padding: 1.25rem 1.5rem;
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  font-size: 1rem;
  color: var(--text-muted);
  display: none;
}

.slide-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2px solid #f1f5f9;
  padding-top: 2rem;
  margin-top: 2.25rem;
  gap: 1rem;
  flex-wrap: wrap;
}

.btn-ctrl {
  padding: 0.8rem 1.5rem;
  font-size: 1rem;
  font-weight: 700;
  border-radius: var(--radius-sm);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: all 0.2s;
  border: none;
  font-family: inherit;
}

.btn-ctrl.secondary {
  background: #f1f5f9;
  color: var(--text-muted);
  border: 1px solid #cbd5e1;
}

.btn-ctrl.secondary:hover {
  background: #e2e8f0;
  color: var(--gz-text-dark);
}

/* --- 10. PENGATURAN MODE CETAK DOKUMEN (PRINT TO PDF) --- */
@media print {
  .site-header,
  .print-action-bar,
  .sound-toggle-bar,
  .slide-controls,
  nav,
  .btn-ctrl,
  .hero-meta {
    display: none !important;
  }

  .view-section {
    display: none !important;
  }

  #worksheet-view {
    display: block !important;
  }

  .content-wrapper {
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .worksheet-paper {
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  body {
    background: #ffffff !important;
    color: #000000 !important;
  }

  .large-answer-area {
    border: 1.5px solid #000000 !important;
    box-shadow: none !important;
  }
}
